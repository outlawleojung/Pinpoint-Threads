// Pinpoint-Threads Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Account: 발행 대상 쓰레드 계정 (4개)
// ==========================================
model Account {
  id                 String    @id @default(cuid())
  handle             String    @unique
  threadsUserId      String    @unique
  accessToken        String
  tokenExpiresAt     DateTime?
  personaPrompt      String    @db.Text
  timezone           String    @default("Asia/Seoul")
  activeHourStart    Int       @default(8)
  activeHourEnd      Int       @default(23)
  userAgent          String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  posts              Post[]
  engagementLogs     EngagementLog[]
  dailyPostCounts    DailyPostCount[]
}

// ==========================================
// SourceItem: 해외/국내 쓰레드에서 수집한 원본
// ==========================================
model SourceItem {
  id            String    @id @default(cuid())
  sourceUrl     String    @unique
  contentHash   String    @unique
  rawText       String    @db.Text
  mediaUrls     String[]
  authorHandle  String?
  language      String?
  collectedAt   DateTime  @default(now())

  posts         Post[]

  @@index([collectedAt])
}

// ==========================================
// CommerceProduct: 매칭된 커머스 상품 (쿠팡/무신사)
// ==========================================
enum CommerceChannel {
  COUPANG
  MUSINSA
}

model CommerceProduct {
  id             String          @id @default(cuid())
  channel        CommerceChannel
  externalId     String
  productName    String
  productUrl     String
  deeplinkUrl    String
  thumbnailUrl   String
  price          Int?
  rating         Float?
  category       String?
  createdAt      DateTime        @default(now())

  posts          Post[]

  @@unique([channel, externalId])
  @@index([channel, category])
}

// ==========================================
// Post: 파이프라인 State Machine의 중심
// ==========================================
enum PostState {
  DRAFT
  CLASSIFYING
  MATCHING
  COPYWRITING
  PENDING_APPROVAL
  APPROVED
  PUBLISHING
  PUBLISHED
  REJECTED
  FAILED
}

model Post {
  id                  String            @id @default(cuid())
  state               PostState         @default(DRAFT)

  accountId           String
  account             Account           @relation(fields: [accountId], references: [id])

  sourceItemId        String
  sourceItem          SourceItem        @relation(fields: [sourceItemId], references: [id])

  commerceProductId   String?
  commerceProduct     CommerceProduct?  @relation(fields: [commerceProductId], references: [id])

  generatedBody       String?           @db.Text
  generatedReply      String?           @db.Text
  mediaUrl            String?           // deprecated; use mediaUrls
  mediaUrls           String[]          // Cloudinary 업로드 결과 공개 URL 목록
  sourceMediaUrls     String[]          // 원본 소스 미디어 URL 목록 (참고용)
  replyVariantUsed    Int?              // Reply Composer 사용한 양식 (1~4)

  telegramMessageId   String?
  approvedAt          DateTime?
  scheduledAt         DateTime?
  publishedAt         DateTime?
  threadsPostId       String?
  threadsReplyId      String?

  rejectionReason     String?
  visionMatchScore    Float?
  retryCount          Int               @default(0)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  insightSnapshots    PostInsightSnapshot[]

  @@unique([accountId, commerceProductId, createdAt])
  @@index([state])
  @@index([scheduledAt])
}

// ==========================================
// PostInsightSnapshot: 발행 후 성과 스냅샷 (24h · 72h)
// ==========================================
model PostInsightSnapshot {
  id                 String    @id @default(cuid())
  postId             String
  post               Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  hoursAfterPublish  Int       // 24, 72
  collectedAt        DateTime  @default(now())

  likes              Int       @default(0)
  replies            Int       @default(0)
  reposts            Int       @default(0)
  quotes             Int       @default(0)
  views              Int       @default(0)

  engagementScore    Float?    // (likes + replies*3 + reposts*5 + quotes*4) / max(views, 1)

  raw                Json?

  @@unique([postId, hoursAfterPublish])
  @@index([collectedAt])
}

// ==========================================
// EngagementLog: 맞스하리 액션 이력 (일 3회 캡)
// ==========================================
enum EngagementAction {
  LIKE
  REPOST
  REPLY
}

model EngagementLog {
  id            String            @id @default(cuid())
  accountId     String
  account       Account           @relation(fields: [accountId], references: [id])
  targetHandle  String
  targetPostId  String
  action        EngagementAction
  executedAt    DateTime          @default(now())

  @@index([accountId, executedAt])
}

// ==========================================
// DailyPostCount: 계정별 일일 발행/스하리 카운터
// ==========================================
model DailyPostCount {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  date            DateTime @db.Date
  publishedCount  Int      @default(0)
  engagementCount Int      @default(0)

  @@unique([accountId, date])
  @@index([date])
}

// ==========================================
// AdminUser: 관리 UI 접근 계정 (Basic Auth backing)
// ==========================================
model AdminUser {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String    // bcrypt
  displayName   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  loginCount    Int       @default(0)

  @@index([isActive])
}

// ==========================================
// TrendSignal: 자율 트렌드 감지 (Lane 2)
// 여러 소스(네이버·구글·TikTok CC·쿠팡 랭킹 등)의 신호를 정규화
// ==========================================
enum TrendSource {
  NAVER_DATALAB
  GOOGLE_TRENDS
  TIKTOK_CREATIVE_CENTER
  COUPANG_RANKING
  MUSINSA_RANKING
  XIAOHONGSHU_DISCOVER
  INSTAGRAM_REELS
  MANUAL
}

enum TrendCategory {
  BEAUTY_SKINCARE
  BEAUTY_MAKEUP
  FASHION
  HOME
  KITCHEN
  BABY_KIDS
  HEALTH
  FOOD
  TECH
  MONEY
  OTHER
}

model TrendSignal {
  id                 String          @id @default(cuid())
  source             TrendSource
  category           TrendCategory?
  keyword            String
  brand              String?
  productHint        String?

  // 신호 강도 (adapter별 의미 다름: 검색순위·조회수·랭킹 등)
  currentValue       Float
  previousValue      Float?
  velocityPct        Float?

  // 크로스 플랫폼
  crossPlatformScore Int             @default(1)
  relatedSignalIds   String[]

  // 시계열
  firstSeenAt        DateTime        @default(now())
  lastSeenAt         DateTime        @default(now())
  observationCount   Int             @default(1)
  decayedAt          DateTime?

  // 원본 payload
  rawPayload         Json?

  @@unique([source, keyword])
  @@index([category, velocityPct])
  @@index([lastSeenAt])
  @@index([source, lastSeenAt])
}

// ==========================================
// InboundLink: 시스템에 유입된 콘텐츠 URL 추적
// Lane 1 (사용자 텔레그램) + Lane 2 (자율 트렌드) 공통
// ==========================================
enum InboundPlatform {
  THREADS
  TIKTOK
  XIAOHONGSHU
  INSTAGRAM
  UNKNOWN
}

enum InboundSource {
  MANUAL_TELEGRAM     // Lane 1
  AUTONOMOUS_TREND    // Lane 2
}

enum InboundStatus {
  RECEIVED
  FETCHING
  FETCHED
  CLASSIFYING
  MATCHING
  READY_FOR_APPROVAL
  APPROVED
  PUBLISHED
  REJECTED
  FAILED
}

model InboundLink {
  id              String           @id @default(cuid())
  url             String
  normalizedUrl   String           @unique
  platform        InboundPlatform
  source          InboundSource
  status          InboundStatus    @default(RECEIVED)

  // Adapter fetch 결과
  rawText         String?          @db.Text
  rawLanguage     String?
  mediaUrls       String[]
  authorHandle    String?
  authorFollowers Int?
  engagement      Json?
  publishedAt     DateTime?

  // 하류 참조
  sourceItemId    String?
  postIds         String[]

  // Lane 2 context
  trendSignalId   String?

  errorMessage    String?          @db.Text
  receivedAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, platform])
  @@index([source, receivedAt])
  @@index([receivedAt])
}

// ==========================================
// SeedSource: 벤치마크 수집 대상 (Threads 계정)
// ==========================================
model SeedSource {
  id            String    @id @default(cuid())
  handle        String    @unique
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  lastPolledAt  DateTime?
  lastError     String?   @db.Text
  addedAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  benchmarks    BenchmarkPost[]

  @@index([isActive])
}

// ==========================================
// BenchmarkPost: 수집·검증된 벤치마크 게시글
// (Copywriter 학습·RAG few-shot 소스)
// ==========================================
model BenchmarkPost {
  id                String       @id @default(cuid())

  seedSourceId      String?
  seedSource        SeedSource?  @relation(fields: [seedSourceId], references: [id])
  sourceHandle      String

  threadsPostId     String       @unique  // Threads 원본 게시글 ID
  permalink         String
  contentHash       String       @unique  // dedup 키 (text + primary media)

  text              String       @db.Text
  mediaUrls         String[]

  likesCount        Int          @default(0)
  repliesCount      Int          @default(0)
  repostsCount      Int          @default(0)
  quotesCount       Int          @default(0)

  publishedAt       DateTime?
  collectedAt       DateTime     @default(now())

  // AI viralFactors 분석 결과: { hook_type, structure, tone, length_bucket, cta_type, topic_category }
  viralFactors      Json?
  taggedAt          DateTime?

  // 임베딩은 Task #5e에서 pgvector 컬럼 별도 마이그레이션으로 추가

  @@index([sourceHandle, likesCount])
  @@index([likesCount])
  @@index([collectedAt])
  @@index([taggedAt])
}
