# ==============================================
# Pinpoint-Threads Environment Variables
# Copy to .env and fill in actual values.
# NEVER commit .env to git.
# ==============================================

# --- App ---
NODE_ENV=development
LOG_LEVEL=debug
APP_PORT=3000

# --- Database (Postgres, Docker Compose로 기동) ---
DATABASE_URL=postgresql://pinpoint:pinpoint_dev@localhost:5432/pinpoint_threads?schema=public

# --- Redis (BullMQ, Docker Compose로 기동) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# --- Meta Threads Graph API ---
# App-level (앱 등록 후 발급)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/oauth/threads/callback
# 계정별 토큰은 DB Account 테이블에 저장 (여기 두지 않음)

# --- Coupang Partners Open API ---
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# --- Musinsa Curator API ---
MUSINSA_API_KEY=
MUSINSA_PARTNER_ID=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# 승인 요청 발송/콜백 수신 대상 채팅 ID

# --- Cloudflare R2 (S3 호환) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pinpoint-threads-media
R2_PUBLIC_URL=https://media.example.com

# --- Engagement Worker Safety ---
ENGAGEMENT_DAILY_LIMIT=3
ENGAGEMENT_MIN_DELAY_MINUTES=10
ENGAGEMENT_MAX_DELAY_MINUTES=30

# --- Publishing Safety ---
PUBLISH_ACCOUNT_MIN_GAP_MINUTES=60
PUBLISH_ACCOUNT_MAX_GAP_MINUTES=240
PRODUCT_DEDUP_DAYS=14
