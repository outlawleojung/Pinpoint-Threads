# ==============================================
# Pinpoint-Threads Environment Variables
# Copy to .env and fill in actual values.
# NEVER commit .env to git.
# ==============================================

# --- App ---
NODE_ENV=development
LOG_LEVEL=debug
APP_PORT=3000

# --- Database (Neon 클라우드 Postgres + pgvector, ADR 002) ---
# neon.tech에서 프로젝트 생성 후 Connection string 복사.
# 형식: postgresql://<user>:<pw>@<host>/<db>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-xxx.aws.neon.tech/neondb?sslmode=require

# --- Redis (BullMQ, Docker Compose로 기동) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- LLM Provider Switching ---
# anthropic | gemini
LLM_PROVIDER=gemini

# --- Anthropic (Claude) ---
# 크레딧 필요. Anthropic Console에서 결제 정보 등록.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# --- Google Gemini ---
# https://aistudio.google.com 에서 API 키 발급. 무료 tier 넉넉.
GEMINI_API_KEY=
# Free tier RPD 제한: gemini-3.5-flash=20/일, gemini-3.5-flash-lite=~1000/일
# 2.5-flash-lite는 신규 사용자에게 폐기됨 (Meta 안내: 3.5-flash-lite 사용).
# 실 운영엔 pay 티어 or Anthropic 재전환.
GEMINI_MODEL_MAIN=gemini-3.5-flash-lite
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# --- Meta Threads Graph API ---
# App-level (앱 등록 후 발급)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/oauth/threads/callback
# 계정별 토큰은 DB Account 테이블에 저장 (여기 두지 않음)

# --- Coupang Partners Open API ---
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# --- Musinsa Curator API ---
MUSINSA_API_KEY=
MUSINSA_PARTNER_ID=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# 승인 요청 발송/콜백 수신 대상 채팅 ID

# --- Cloudinary (미디어 호스팅, R2 대체) ---
# cloudinary.com에서 계정 생성 후 Dashboard → Go to API Keys
# 무료 티어: 25 credits/월 (우리 규모는 무료로 충분)
CLOUDINARY_CLOUD_NAME=xwqbwrs1
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=pinpoint-threads

# --- Engagement Worker Safety ---
ENGAGEMENT_DAILY_LIMIT=3
ENGAGEMENT_MIN_DELAY_MINUTES=10
ENGAGEMENT_MAX_DELAY_MINUTES=30

# --- Publishing Safety ---
PUBLISH_ACCOUNT_MIN_GAP_MINUTES=60
PUBLISH_ACCOUNT_MAX_GAP_MINUTES=240
PRODUCT_DEDUP_DAYS=14

# --- Naver Developers · 데이터랩 쇼핑인사이트 (Lane 2 Stage 1) ---
# https://developers.naver.com 앱 등록 후 발급. 무료.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Benchmark Source Collector (Apify Threads Actor) ---
# apify.com 가입 → Settings → Integrations → API token
APIFY_API_TOKEN=
# Apify Store에서 사용할 Threads scraper actor id (예: curious_coder~threads-scraper)
APIFY_ACTOR_ID=
# 벤치마크로 인정할 최소 좋아요 수
BENCHMARK_MIN_LIKES=1000
# poll 주기 (시간)
BENCHMARK_POLL_INTERVAL_HOURS=6

# --- Voyage AI (Task #5e에서 활성화) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
